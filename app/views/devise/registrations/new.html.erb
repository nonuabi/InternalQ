<div class="kv-page">
  <div class="kv-page-header">
    <div class="kv-heading-group">
      <h1>Create your account</h1>
      <p class="kv-page-subtitle">Set up InternalQ for your team using your Google work email. You’ll be the admin. After sign in, go to Integrations to connect Slack, then upload documents from the Documents page.</p>
    </div>
    <div class="kv-badge-row">
      <div class="kv-pill">
        <span class="kv-pill-dot"></span>
        First user = admin
      </div>
    </div>
  </div>

  <div class="kv-inline-form" style="margin-bottom: 1rem;">
    <%= button_to user_google_oauth2_omniauth_authorize_path,
                  method: :post,
                  class: "kv-google-button",
                  form: { data: { turbo: false }, style: "display: inline-block; margin: 0;" } do %>
      <span class="kv-google-icon"></span>
      <span>Continue with Google</span>
    <% end %>
  </div>

  <p class="kv-meta-text kv-meta-muted" style="margin: 0.5rem 0 0.25rem 0;">
    We use your Google work email to create your InternalQ account. No extra password to manage.
  </p>
  <p class="kv-meta-text kv-meta-muted" style="margin: 0 0 0.75rem 0;">
    Can’t use Google sign in? Contact <a href="mailto:abhishekverma.gju@gmail.com">support</a>.
  </p>
</div>

