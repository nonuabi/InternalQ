<div class="kv-page">
  <div class="kv-page-header">
    <div class="kv-heading-group">
      <h1>Log in</h1>
      <p class="kv-page-subtitle">Access your organization’s InternalQ. After logging in you can ask questions (Q&A), view documents, and — if you’re an admin — manage integrations and uploads.</p>
    </div>
    <div class="kv-badge-row">
      <div class="kv-pill">
        <span class="kv-pill-dot"></span>
        Secure sign-in
      </div>
    </div>
  </div>

  <div class="kv-inline-form" style="margin-bottom: 1rem;">
    <%= button_to user_google_oauth2_omniauth_authorize_path,
                  method: :post,
                  class: "kv-google-button",
                  form: { data: { turbo: false }, style: "display: inline-block; margin: 0;" } do %>
      <span class="kv-google-icon"></span>
      <span>Continue with Google</span>
    <% end %>
  </div>

  <p class="kv-meta-text kv-meta-muted" style="margin: 0.5rem 0 0.25rem 0;">
    Log in or get started with your Google work email. We never see your Google password.
  </p>
  <p class="kv-meta-text kv-meta-muted" style="margin: 0 0 0.75rem 0;">
    Trouble with Google sign in? Reach out to <a href="mailto:abhishekverma.gju@gmail.com">support</a>.
  </p>
</div>

