<% content_for :title, "Log in · InternalQ" %>

<div class="kv-page">
  <div class="kv-page-header">
    <div class="kv-heading-group">
      <h1>Log in</h1>
      <p class="kv-page-subtitle">
        Log in to your company’s AI assistant. Ask questions about policies, SOPs, and handbooks, and get instant answers.
      </p>
    </div>

    <div class="kv-badge-row">
      <div class="kv-pill">
        <span class="kv-pill-dot"></span>
        Secure sign-in
      </div>
    </div>
  </div>

  <div class="kv-inline-form" style="margin-bottom: 0.75rem;">
    <%= button_to user_google_oauth2_omniauth_authorize_path,
                  method: :post,
                  class: "kv-google-button",
                  form: { data: { turbo: false }, style: "display: inline-block; margin: 0;" } do %>
      <span class="kv-google-icon"></span>
      <span>Continue with Google</span>
    <% end %>
  </div>

  <p class="kv-meta-text kv-meta-muted" style="margin: 0.25rem 0 0 0;">
    We never see your Google password.
  </p>
  <p class="kv-meta-text kv-meta-muted" style="margin: 0.15rem 0 0;">
    Trouble signing in? Reach out to <%= link_to "support", support_path %>.
  </p>
</div>
