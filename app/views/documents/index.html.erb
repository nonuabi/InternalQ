<div class="kv-page">
  <div class="kv-page-header">
    <div class="kv-heading-group">
      <h1>Documents</h1>
      <p class="kv-page-subtitle"><strong>What’s here:</strong> The files your Q&A uses to answer questions. Upload PDFs or DOCX (handbooks, policies). <strong>How:</strong> Admins can upload and delete; everyone can view. No docs yet? Upload one below to enable Q&A.</p>
    </div>

    <% if current_user.admin? %>
      <%= link_to new_document_path, class: "kv-primary-button" do %>
        <span>Upload document</span>
      <% end %>
    <% else %>
      <div class="kv-tag">
        <span class="kv-tag-dot"></span>
        View only
      </div>
    <% end %>
  </div>

  <% if @documents.any? %>
    <div class="kv-table-card">
      <div class="kv-table-wrapper">
        <table class="kv-table">
          <thead>
            <tr>
              <th>Title</th>
              <th>File</th>
              <th>Status</th>
              <th>Updated</th>
              <th class="kv-nowrap">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% @documents.each do |d| %>
              <tr>
                <td>
                  <div class="kv-meta-text" style="max-width: 260px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                    <%= link_to (d.title.presence || "Untitled"), document_path(d), class: "kv-inline-muted", title: d.title %>
                  </div>
                </td>
                <td>
                  <div class="kv-meta-text kv-mono">
                    <%= d.file.attached? ? d.file.filename.to_s : "-" %>
                  </div>
                </td>
                <td>
                  <% normalized_status = d.status.to_s.downcase %>
                  <div>
                    <span class="kv-status-pill" data-status="<%= normalized_status %>">
                      <span class="kv-status-dot"></span>
                      <span><%= d.status.presence || "unknown" %></span>
                    </span>
                    <% if normalized_status == "failed" && d.respond_to?(:error_message) && d.error_message.present? %>
                      <div class="kv-meta-text kv-inline-danger" style="margin-top: 0.2rem; max-width: 260px; white-space: normal;">
                        <span class="kv-mono">Error:</span>
                        <%= truncate(d.error_message, length: 120) %>
                      </div>
                    <% end %>
                  </div>
                </td>
                <td>
                  <div class="kv-meta-text">
                    <%= d.updated_at.strftime("%d %b %Y · %H:%M") %>
                  </div>
                </td>
                <td>
                  <div class="kv-badge-row">
                    <%= link_to "Open", document_path(d), class: "kv-secondary-button" %>
                    <% if current_user.admin? %>
                      <%= link_to "Delete",
                                  document_path(d),
                                  method: :delete,
                                  data: { turbo_confirm: "Are you sure you want to delete this document?" },
                                  class: "kv-ghost-button kv-inline-danger" %>
                    <% end %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  <% else %>
    <div class="kv-empty-state">
      <div class="kv-empty-main">
        <div class="kv-empty-title">No documents yet</div>
        <div class="kv-empty-subtitle">Upload a PDF or DOCX (e.g. handbook, policy) to unlock Q&A. Only admins can upload.</div>
      </div>
      <% if current_user.admin? %>
        <%= link_to "Upload document", new_document_path, class: "kv-primary-button" %>
      <% else %>
        <p class="kv-meta-text kv-meta-muted">Ask an admin to upload documents.</p>
      <% end %>
    </div>
  <% end %>
</div>