<h1>Documents</h1>

<h2>
    <%= link_to "Upload Document", new_document_path if current_user.admin? %>
</h2>

<table border="1" cellpadding="8">
  <tr>
    <th>Title</th>
    <th>File</th>
    <th>Status</th>
    <th>Updated</th>
    <th>Actions</th>
  </tr>
  <% @documents.each do |d| %>
    <tr>
      <td><%= d.title.presence || "Untitled" %></td>
      <td><%= d.file.attached? ? d.file.filename.to_s : "-" %></td>
      <td><%= d.status %></td>
      <td><%= d.updated_at.strftime("%d %b %Y %H:%M") %></td>
      <td>
        <%if current_user.admin? %>
          <%= link_to "Delete", document_path(d), method: :delete , data: { turbo_confirm: "Are you sure you want to delete this document?" } %>
        <% end %>
      </td>
    </tr>
  <% end %>
</table>