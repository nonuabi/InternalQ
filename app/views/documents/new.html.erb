<div class="kv-page">
  <div class="kv-page-header">
    <div class="kv-heading-group">
      <h1>Upload document</h1>
      <p class="kv-page-subtitle"><strong>What:</strong> Add a PDF or DOCX (handbook, policy, runbook) so Q&A can answer from it. <strong>How:</strong> Give it a title, pick a file, and submit. We process it in the background; when status is complete, it's searchable.</p>
    </div>

    <%= link_to "Back to documents", documents_path, class: "kv-ghost-button" %>
  </div>

  <%= form_with model: @document, html: { class: "kv-form-grid" } do |f| %>
    <% if @document.errors.any? %>
      <div class="kv-empty-state kv-error-state">
        <div class="kv-empty-main">
          <div class="kv-empty-title">We couldn’t upload the document</div>
          <div class="kv-empty-subtitle">
            <%= @document.errors.full_messages.to_sentence %>
          </div>
        </div>
      </div>
    <% end %>

    <div>
      <div class="kv-field-label">Title</div>
      <%= f.text_field :title, class: "kv-input", placeholder: "e.g. Employee handbook 2025", maxlength: 80 %>
      <div class="kv-field-hint">
        Shown in the app and in answer sources (max 80 characters).
      </div>
    </div>

    <div>
      <div class="kv-field-label">File</div>
      <%= f.file_field :file, class: "kv-file-input" %>
      <div class="kv-field-hint">
        PDF or DOCX. Max size 1 MB. Large files are chunked automatically for search.
      </div>
      <% if @document.errors[:file].any? %>
        <div class="kv-field-error">
          <%= @document.errors[:file].to_sentence %>
        </div>
      <% end %>
    </div>

    <div class="kv-form-footer">
      <%= f.submit "Upload", class: "kv-primary-button" %>
      <span class="kv-meta-text kv-meta-muted">
        Uploading will kick off background processing so it’s searchable in Q&A.
      </span>
    </div>
  <% end %>

  <script>
    function attachDocumentTitleAutofill() {
      var titleInput = document.getElementById("document_title");
      var fileInput  = document.getElementById("document_file");

      if (!titleInput || !fileInput) return;
      if (fileInput.dataset.autofillBound === "true") return;

      fileInput.addEventListener("change", function() {
        if (!fileInput.files || fileInput.files.length === 0) return;
        if (titleInput.value && titleInput.value.trim().length > 0) return;

        var file = fileInput.files[0];
        if (!file || !file.name) return;

        var name = file.name.replace(/\.[^\.]+$/, "");
        titleInput.value = name;
      });

      fileInput.dataset.autofillBound = "true";
    }

    document.addEventListener("turbo:load", attachDocumentTitleAutofill);

    if (document.readyState !== "loading") {
      attachDocumentTitleAutofill();
    }
  </script>
</div>