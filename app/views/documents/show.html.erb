<div class="kv-page">
  <div class="kv-page-header">
    <div class="kv-heading-group">
      <h1><%= @document.title.presence || "Untitled document" %></h1>
      <p>
        <span class="kv-meta-text kv-meta-muted">
          <span class="kv-mono"><%= @document.file.attached? ? @document.file.filename.to_s : "No file attached" %></span>
          · Last updated <%= @document.updated_at.strftime("%d %b %Y · %H:%M") %>
        </span>
      </p>
    </div>

    <div class="kv-badge-row">
      <% normalized_status = @document.status.to_s.downcase %>
      <span class="kv-status-pill" data-status="<%= normalized_status %>">
        <span class="kv-status-dot"></span>
        <span><%= @document.status.presence || "unknown" %></span>
      </span>

      <%= link_to "All documents", documents_path, class: "kv-secondary-button" %>

      <% if current_user.admin? %>
        <%= button_to "Delete",
                      document_path(@document),
                      method: :delete,
                      data: { turbo_confirm: "Are you sure you want to delete this document?" },
                      class: "kv-ghost-button kv-inline-danger" %>
      <% end %>
    </div>
  </div>

  <div class="kv-soft-divider"></div>

  <div class="kv-answer-block">
    <div class="kv-answer-header">
      <div class="kv-answer-title">Extracted text</div>
      <div class="kv-chip">
        <span class="kv-chip-dot"></span>
        Chunked for search
      </div>
    </div>
    <div class="kv-answer-body kv-mono">
      <%= @document.extracted_text.presence || "No text was extracted from this file." %>
    </div>
  </div>
</div>
