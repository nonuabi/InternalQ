<% content_for :title, "Team · InternalQ" %>
<div class="kv-page">
  <div class="kv-page-header">
    <div class="kv-heading-group">
      <h1>Team</h1>
      <p class="kv-page-subtitle"><strong>Who’s here:</strong> Everyone in your organization with access to InternalQ. Admins can upload documents and manage integrations; employees can use Q&A and view documents. Only admins can promote others to admin.</p>
    </div>
    <% unless current_user.admin? %>
      <div class="kv-tag">
        <span class="kv-tag-dot"></span>
        View only
      </div>
    <% end %>
  </div>


  <% if @employees.any? %>
    <div class="kv-table-card">
      <div class="kv-table-wrapper">
        <table class="kv-table">
          <thead>
            <tr>
              <th>Email</th>
              <th>Role</th>
              <th>Joined</th>
              <% if current_user.admin? %>
                <th class="kv-nowrap">Actions</th>
              <% end %>
            </tr>
          </thead>
          <tbody>
            <% @employees.each do |u| %>
              <tr>
                <td>
                  <div class="kv-team-email">
                    <%= u.email %>
                    <% if u.id == current_user.id %>
                      <span class="kv-pill kv-pill-you">You</span>
                    <% end %>
                  </div>
                </td>
                <td>
                  <% if u.admin? %>
                    <span class="kv-status-pill" data-status="complete">
                      <span class="kv-status-dot"></span>
                      Admin
                    </span>
                  <% else %>
                    <span class="kv-status-pill" data-status="pending">
                      <span class="kv-status-dot"></span>
                      Employee
                    </span>
                  <% end %>
                </td>
                <td>
                  <span class="kv-meta-text"><%= u.created_at.strftime("%d %b %Y") %></span>
                </td>
                <% if current_user.admin? %>
                  <td>
                    <% if u.id != current_user.id && u.employee? %>
                      <%= button_to "Make admin",
                                    make_admin_team_member_path(u.id),
                                    method: :post,
                                    form: { class: "kv-inline-form" },
                                    class: "kv-secondary-button kv-button-sm",
                                    data: { turbo_confirm: "Make #{u.email} an admin? They will be able to upload documents, manage integrations, and promote others." } %>
                    <% elsif u.id == current_user.id %>
                      <span class="kv-meta-text kv-meta-muted">—</span>
                    <% else %>
                      <span class="kv-meta-text kv-meta-muted">Already admin</span>
                    <% end %>
                  </td>
                <% end %>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  <% else %>
    <div class="kv-empty-state">
      <div class="kv-empty-main">
        <div class="kv-empty-title">No other members yet</div>
        <div class="kv-empty-subtitle">When others from your organization sign up and connect Slack (or join your workspace), they’ll appear here.</div>
      </div>
    </div>
  <% end %>
</div>
