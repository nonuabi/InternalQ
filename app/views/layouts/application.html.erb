<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "InternalQ · Your company’s AI assistant" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="<%= asset_path('internalQ-icon.png') %>" type="image/png">
    <link rel="apple-touch-icon" href="<%= asset_path('internalQ-icon.png') %>">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <div class="kv-app-shell">
      <header class="kv-app-header">
        <div class="kv-app-header-inner">
          <div class="kv-brand">
            <div class="kv-logo">
              <%= image_tag "internalQ-icon.png", alt: "InternalQ logo", class: "kv-logo-image" %>
            </div>
            <div class="kv-brand-text">
              <div class="kv-brand-title">InternalQ</div>
              <div class="kv-brand-subtitle">Your company’s AI assistant</div>
            </div>
          </div>

          <% if defined?(user_signed_in?) && user_signed_in? %>
            <nav class="kv-nav">
              <%= link_to "Q&A", root_path, class: (current_page?(root_path) ? "kv-nav-active" : "") %>
              <%= link_to "Documents", documents_path, class: (controller_name == "documents" ? "kv-nav-active" : "") %>
              <%= link_to "Integrations", integrations_path, class: (controller_name == "integrations" ? "kv-nav-active" : "") %>
              <%= link_to "Team", team_path, class: (controller_name == "employees" ? "kv-nav-active" : "") %>
            </nav>

            <div class="kv-header-context">
              <span class="kv-role-pill kv-role-<%= current_user.role %>">
                <%= current_user.admin? ? "Admin" : "Employee" %>
              </span>
              <div class="kv-user-pill">
                <span><%= current_user.email %></span>
                <div class="kv-user-dot"></div>
                <%= button_to "Logout",
                              destroy_user_session_path,
                              method: :delete,
                              form: { style: "margin: 0;" },
                              class: "kv-ghost-button",
                              data: { turbo_confirm: "Are you sure you want to log out?" } %>
              </div>
            </div>
          <% else %>
            <nav class="kv-nav kv-nav-public">
              <%= link_to "Install", installation_path, class: (current_page?(installation_path) ? "kv-nav-active" : "") %>
              <%= link_to "Log in", new_user_session_path, class: (current_page?(new_user_session_path) ? "kv-nav-active" : "") %>
            </nav>
          <% end %>
        </div>
      </header>

      <main class="kv-main">
        <div class="kv-main-inner">
          <% if flash.any? %>
            <div class="kv-flash" role="status" aria-live="polite">
              <% flash.each do |type, message| %>
                <div class="kv-flash-message kv-flash-<%= type %>">
                  <%= message %>
                </div>
              <% end %>
            </div>
          <% end %>
          <%= yield %>
        </div>
      </main>

      <footer class="kv-footer">
        <% if defined?(user_signed_in?) && user_signed_in? %>
          <span>InternalQ · Dashboard</span>
          <% if current_user.organization.present? %>
            <span class="kv-footer-org"><%= current_user.organization.name %></span>
          <% end %>
        <% else %>
          <span>InternalQ · your company’s AI assistant</span>
        <% end %>
        <span class="kv-footer-links">
          <%= link_to "Install", installation_path %>
          <%= link_to "Privacy", privacy_path %>
          <%= link_to "Terms", terms_path %>
          <%= link_to "Support", support_path %>
        </span>
      </footer>
    </div>
  </body>
</html>
