<!DOCTYPE html>
<html lang="en">
  <head>
    <%= render "shared/google_analytics" %>
    <title><%= seo_title %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">

    <%# SEO meta tags %>
    <meta name="description" content="<%= seo_description %>">
    <link rel="canonical" href="<%= seo_canonical %>">

    <%# Open Graph (controls how links appear when shared on Slack, LinkedIn, Twitter etc.) %>
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="InternalQ">
    <meta property="og:title" content="<%= seo_title %>">
    <meta property="og:description" content="<%= seo_description %>">
    <meta property="og:url" content="<%= seo_canonical %>">
    <meta property="og:image" content="<%= SeoHelper::DEFAULT_OG_IMAGE %>">

    <%# Twitter/X card %>
    <meta name="twitter:card" content="summary">
    <meta name="twitter:title" content="<%= seo_title %>">
    <meta name="twitter:description" content="<%= seo_description %>">
    <meta name="twitter:image" content="<%= SeoHelper::DEFAULT_OG_IMAGE %>">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png" sizes="192x192">
    <link rel="icon" href="/favicon.ico" sizes="48x48">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>

    <%# Structured data — tells Google exactly what InternalQ is %>
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      "name": "InternalQ",
      "url": "https://internalq.zezlab.com",
      "description": "InternalQ lets your team ask questions about internal documents directly in Slack. Upload handbooks, policies and SOPs - get instant AI-powered answers.",
      "applicationCategory": "BusinessApplication",
      "operatingSystem": "Web, Slack",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD",
        "description": "Free plan available"
      },
      "publisher": {
        "@type": "Organization",
        "name": "Zezlab",
        "url": "https://internalq.zezlab.com",
        "logo": "https://internalq.zezlab.com/icon.png"
      }
    }
    </script>
  </head>

  <body>
    <div class="kv-app-shell">
      <header class="kv-app-header">
        <div class="kv-app-header-inner">
          <div class="kv-brand">
            <div class="kv-logo">
              <%= image_tag "internalQ-icon.png", alt: "InternalQ logo", class: "kv-logo-image" %>
            </div>
            <%== link_to (user_signed_in? ? dashboard_path : root_path), class: "kv-brand-text" do %>
              <div class="kv-brand-text">
                <div class="kv-brand-title">InternalQ</div>
                <div class="kv-brand-subtitle">Your company’s AI assistant</div>
              </div>
            <% end %>
          </div>

          <% if defined?(user_signed_in?) && user_signed_in? %>
            <nav class="kv-nav">
              <%= link_to "Q&A", ask_path, class: (controller_name == "qa" ? "kv-nav-active" : "") %>
              <%= link_to "Documents", documents_path, class: (controller_name == "documents" ? "kv-nav-active" : "") %>
              <%= link_to "Integrations", integrations_path, class: (controller_name == "integrations" ? "kv-nav-active" : "") %>
            </nav>

            <div class="kv-header-context">
              <span class="kv-role-pill kv-role-<%= current_user.role %>">
                <%= current_user.admin? ? "Admin" : "Employee" %>
              </span>
              <div class="kv-user-pill">
                <span><%= current_user.email %></span>
                <div class="kv-user-dot"></div>
                <%= button_to "Logout",
                              destroy_user_session_path,
                              method: :delete,
                              form: { style: "margin: 0;" },
                              class: "kv-ghost-button",
                              data: { turbo_confirm: "Are you sure you want to log out?" } %>
              </div>
            </div>
          <% end %>
        </div>
      </header>

      <main class="kv-main">
        <div class="kv-main-inner">
          <% if flash.any? %>
            <div class="kv-flash" role="status" aria-live="polite">
              <% flash.each do |type, message| %>
                <div class="kv-flash-message kv-flash-<%= type %>">
                  <%= message %>
                </div>
              <% end %>
            </div>
          <% end %>
          <%= yield %>
        </div>
      </main>

      <footer class="kv-footer">
        <% if defined?(user_signed_in?) && user_signed_in? %>
          <span class="kv-footer-links">
            <%= link_to dashboard_path, class: "kv-footer-link" do %>
              Dashboard<% if current_user.organization.present? %> · <%= current_user.organization.name %><% end %>
            <% end %>
            <%= link_to "Team Members", team_path %>
            <%= link_to "Privacy", privacy_path %>
            <%= link_to "Terms", terms_path %>
            <%= link_to "Support", support_path %>
          </span>
        <% end %>
      </footer>
    </div>
  </body>
</html>
