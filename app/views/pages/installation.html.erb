<%# ── Features ── %>
<section class="lp-block" style="padding-top:0">
  <div class="lp-shell">
    <div class="lp-section-head">
      <div class="lp-section-eyebrow">What's different</div>
      <h2 class="lp-section-title">Built like an internal tool, not a chatbot wrapper.</h2>
    </div>
    <div class="lp-features">
      <div class="lp-feature">
        <div class="lp-feature-glyph"><%= cite_svg %></div>
        <h3>Citations on every answer</h3>
        <p>Each response links back to the source document, section, and page. Your team trusts it because they can verify it.</p>
      </div>
      <div class="lp-feature">
        <div class="lp-feature-glyph"><%= bell_svg %></div>
        <h3>A log of what you don't document</h3>
        <p>Every "I don't know" gets logged. Admins see exactly which gaps to fill — turn your docs into living artifacts.</p>
      </div>
      <div class="lp-feature">
        <div class="lp-feature-glyph"><%= lock_svg %></div>
        <h3>Your content, isolated</h3>
        <p>Documents are scoped to your workspace. Never mixed with another customer's data. Never used as training material.</p>
      </div>
      <div class="lp-feature">
        <div class="lp-feature-glyph"><%= bolt_svg %></div>
        <h3>Channel-aware</h3>
        <p>Scope a document set to #engineering or #sales. Runbooks stay where engineers can find them; HR policies don't clutter eng channels.</p>
      </div>
      <div class="lp-feature">
        <div class="lp-feature-glyph"><%= doc_svg %></div>
        <h3>Re-index on edit</h3>
        <p>Replace a PDF and InternalQ re-indexes in seconds. Answers always reflect the latest version — no stale policy quotes.</p>
      </div>
      <div class="lp-feature">
        <div class="lp-feature-glyph"><%= shield_svg %></div>
        <h3>Admin audit trail</h3>
        <p>See who asked what, what was answered, and which source was cited. Export to CSV any time.</p>
      </div>
    </div>
  </div>
</section>

<%# ── Security ── %>
<section class="lp-block" id="security" style="padding-top:0">
  <div class="lp-shell">
    <div class="lp-security">
      <div>
        <div class="lp-section-eyebrow">Trust &amp; security</div>
        <h2 class="lp-section-title">Designed for sensitive internal content.</h2>
        <p class="lp-section-sub" style="margin-bottom:32px">
          Your employee handbook is not training data. Here's how we keep it that way.
        </p>
        <div class="lp-security-list">
          <div class="lp-security-row">
            <div class="lp-security-glyph"><%= lock_svg %></div>
            <div>
              <h4>Encrypted everywhere</h4>
              <p>AES-256 at rest, TLS 1.3 in transit. Document content is scoped to your workspace at the storage layer.</p>
            </div>
          </div>
          <div class="lp-security-row">
            <div class="lp-security-glyph"><%= shield_svg %></div>
            <div>
              <h4>No training, ever</h4>
              <p>We use OpenAI's enterprise endpoints with zero data retention. Your content is sent for inference and immediately dropped.</p>
            </div>
          </div>
          <div class="lp-security-row">
            <div class="lp-security-glyph"><%= doc_svg %></div>
            <div>
              <h4>You own everything</h4>
              <p>Export or delete your data at any time. Workspace deletion purges within 30 days; document deletes are immediate.</p>
            </div>
          </div>
        </div>
      </div>

      <div class="lp-cert-card">
        <h4>Compliance status</h4>
        <div class="lp-cert-list">
          <div class="lp-cert-item">
            <span class="lp-cert-glyph"><%= check_svg %></span>
            <span class="lp-cert-label">GDPR &amp; CCPA aligned</span>
            <span class="lp-cert-status lp-status-yes">Live</span>
          </div>
          <div class="lp-cert-item">
            <span class="lp-cert-glyph"><%= check_svg %></span>
            <span class="lp-cert-label">Encryption at rest &amp; transit</span>
            <span class="lp-cert-status lp-status-yes">Live</span>
          </div>
          <div class="lp-cert-item">
            <span class="lp-cert-glyph"><%= check_svg %></span>
            <span class="lp-cert-label">DPA &amp; subprocessor list</span>
            <span class="lp-cert-status lp-status-yes">Available</span>
          </div>
          <div class="lp-cert-item">
            <span class="lp-cert-glyph lp-cert-glyph-warn"><%= bolt_svg %></span>
            <span class="lp-cert-label">Slack Marketplace listing</span>
            <span class="lp-cert-status lp-status-pending">In review</span>
          </div>
          <div class="lp-cert-item">
            <span class="lp-cert-glyph lp-cert-glyph-muted"><%= shield_svg %></span>
            <span class="lp-cert-label">SOC 2 Type II</span>
            <span class="lp-cert-status lp-status-soon">Targeting Q3 '26</span>
          </div>
          <div class="lp-cert-item">
            <span class="lp-cert-glyph lp-cert-glyph-muted"><%= shield_svg %></span>
            <span class="lp-cert-label">SSO / SCIM</span>
            <span class="lp-cert-status lp-status-soon">Targeting Q3 '26</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

