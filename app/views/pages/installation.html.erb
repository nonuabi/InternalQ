<%# ── Trust strip ── %>
<div class="lp-shell">
  <div class="lp-trust-strip">
    <div class="lp-trust-item">
      <%= shield_svg %>
      <strong>Encrypted at rest &amp; in transit</strong>
      <span>AES-256 · TLS 1.3</span>
    </div>
    <div class="lp-trust-item">
      <%= lock_svg %>
      <strong>Your docs stay private</strong>
      <span>Never used as training data</span>
    </div>
    <div class="lp-trust-item">
      <%= cite_svg %>
      <strong>Every answer cited</strong>
      <span>With page-level references</span>
    </div>
    <div class="lp-trust-item">
      <%= bell_svg %>
      <strong>Honest about gaps</strong>
      <span>Says "I don't know" when it should</span>
    </div>
  </div>
</div>

<%# ── How it works ── %>
<section class="lp-block" id="how">
  <div class="lp-shell">
    <div class="lp-section-head">
      <div class="lp-section-eyebrow">How it works</div>
      <h2 class="lp-section-title">Up and running in the time it takes to make coffee.</h2>
      <p class="lp-section-sub">Three steps. No engineering needed. Upload your docs, connect Slack, and your team can start asking questions immediately.</p>
    </div>

    <div class="lp-steps">
      <div class="lp-step">
        <div class="lp-step-num">
          <span class="lp-step-badge">1</span>
          Upload
        </div>
        <h3>Drop in your docs</h3>
        <p>PDFs, Word, Markdown. Handbooks, SOPs, runbooks, benefits guides — up to 10&nbsp;MB each. Indexed in the background.</p>
        <div class="lp-step-illo">
          <div class="lp-illo-rows">
            <div class="lp-illo-row">
              <span class="lp-illo-badge-pdf"></span>
              Handbook 2026.pdf
              <span class="lp-illo-tag-indexed">✓ indexed</span>
            </div>
            <div class="lp-illo-row">
              <span class="lp-illo-badge-docx"></span>
              Benefits.docx
              <span class="lp-illo-tag-pending">indexing…</span>
            </div>
          </div>
        </div>
      </div>

      <div class="lp-step">
        <div class="lp-step-num">
          <span class="lp-step-badge">2</span>
          Connect
        </div>
        <h3>One-click Slack install</h3>
        <p>OAuth into your workspace. The bot introduces itself in #general so the team knows it's there — no rollout email needed.</p>
        <div class="lp-step-illo">
          <div class="lp-illo-connect">
            <%= image_tag "internalQ-icon.png", alt: "InternalQ", class: "lp-illo-bot" %>
            <div class="lp-illo-connect-meta">
              <span class="lp-illo-connect-title">Connected to <strong>acme-corp</strong></span>
              <span class="lp-illo-connect-sub">14 channels · added 2 min ago</span>
            </div>
          </div>
        </div>
      </div>

      <div class="lp-step">
        <div class="lp-step-num">
          <span class="lp-step-badge">3</span>
          Ask
        </div>
        <h3>The team self-serves</h3>
        <p>Anyone can @mention InternalQ in any channel or DM it directly. Cited answers in seconds. Unanswered questions feed your gap log.</p>
        <div class="lp-step-illo">
          <div class="lp-illo-ask">
            <span class="lp-illo-q">
              <span class="lp-mention" style="font-size:12px">@InternalQ</span> what's our 401k match?
            </span>
            <span class="lp-illo-a">
              → 6% match, vests over 3 years. <span class="lp-illo-cite">Benefits.pdf §2</span>
            </span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

