<% content_for :title, "Install InternalQ · Slack" %>
<div class="kv-page kv-install-page">
  <div class="kv-install-hero">
    <h1 class="kv-install-title">Stop answering the same questions again.</h1>

    <p class="kv-install-subtitle">
      Turn your company documents into a private AI assistant.<br />
      Your team asks questions. It answers instantly, in Slack or the web app.
    </p>

    <p class="kv-install-subtitle kv-install-subtitle-compact">
      In Slack, your team can ask:
    </p>

    <div class="kv-install-example">
      <span class="kv-mono">@InternalQ</span>
      <span class="kv-mono">What is our leave policy?</span>
    </div>

    <p class="kv-install-trust">Answers are generated only from your company’s documents.</p>

    <div class="kv-install-cta">
      <%= button_to user_google_oauth2_omniauth_authorize_path,
                    method: :post,
                    class: "kv-google-button",
                    form: { data: { turbo: false }, style: "margin: 0;" } do %>
        <span class="kv-google-icon"></span>
        <span>Continue with Google</span>
      <% end %>

      <div class="kv-install-meta">
        <div class="kv-install-meta-row">
          <span class="kv-meta-text kv-meta-muted">Takes 30 seconds · No passwords shared.</span>
          <span class="kv-meta-text kv-meta-muted">Perfect for handbooks, policies, and SOPs.</span>
        </div>
        <div class="kv-install-login-link">
          <%= link_to "Already using InternalQ? Log in", new_user_session_path %>
        </div>
      </div>
    </div>

    <div class="kv-soft-divider"></div>

    <p class="kv-meta-text kv-meta-muted">
      Need help? <%= link_to "Support", support_path %> · <%= link_to "Privacy policy", privacy_path %>
    </p>
  </div>
</div>