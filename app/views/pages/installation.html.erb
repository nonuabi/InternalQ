<% content_for :title, "InternalQ · AI knowledge assistant for Slack teams" %>
<% content_for :meta_description, "InternalQ lets your team ask questions about internal documents directly in Slack. Upload handbooks, policies and SOPs — get instant AI-powered answers cited from your own docs." %>
<% content_for :canonical_url, "https://internalq.zezlab.com" %>

<%# ── Icon helpers ── %>
<% check_svg    = '<svg class="lp-icon-sm lp-check-icon" viewBox="0 0 16 16" fill="none"><path d="M3 8.4 6.4 12 13 4.8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>'.html_safe %>
<% shield_svg   = '<svg class="lp-icon-md" viewBox="0 0 20 20" fill="none"><path d="M10 2.5 4 4.6V10c0 3.4 2.5 6 6 7.5 3.5-1.5 6-4.1 6-7.5V4.6L10 2.5Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/><path d="m7.5 10 1.8 1.8L13 8.2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>'.html_safe %>
<% lock_svg     = '<svg class="lp-icon-md" viewBox="0 0 20 20" fill="none"><rect x="4.5" y="9" width="11" height="8" rx="1.8" stroke="currentColor" stroke-width="1.5"/><path d="M7 9V6.8A3 3 0 0 1 10 4a3 3 0 0 1 3 2.8V9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>'.html_safe %>
<% doc_svg      = '<svg class="lp-icon-md" viewBox="0 0 20 20" fill="none"><path d="M5 3h6.5L15 6.5V17H5V3Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/><path d="M11 3v3.5h4" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/><path d="M7.5 10h5M7.5 12.5h5M7.5 15h3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>'.html_safe %>
<% cite_svg     = '<svg class="lp-icon-md" viewBox="0 0 20 20" fill="none"><path d="M5 5.5h10M5 9h10M5 12.5h6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><circle cx="14.5" cy="13.5" r="2" stroke="currentColor" stroke-width="1.5"/></svg>'.html_safe %>
<% bell_svg     = '<svg class="lp-icon-md" viewBox="0 0 20 20" fill="none"><path d="M5 14h10l-1.2-1.6A4 4 0 0 1 13 10V8a3 3 0 0 0-6 0v2c0 .9-.3 1.7-.8 2.4L5 14Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/><path d="M8.5 16a1.5 1.5 0 0 0 3 0" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>'.html_safe %>
<% bolt_svg     = '<svg class="lp-icon-md" viewBox="0 0 20 20" fill="none"><path d="M11 3 5 11h4l-1 6 6-8h-4l1-6Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg>'.html_safe %>
<% upload_svg   = '<svg class="lp-icon-md" viewBox="0 0 20 20" fill="none"><path d="M10 3v9m0-9L7 6m3-3 3 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/><path d="M4 13v2.5A1.5 1.5 0 0 0 5.5 17h9a1.5 1.5 0 0 0 1.5-1.5V13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>'.html_safe %>
<% plus_svg     = '<svg class="lp-icon-sm lp-faq-chev" viewBox="0 0 16 16" fill="none"><path d="M8 3v10M3 8h10" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>'.html_safe %>

