<% content_for :title, "Privacy Policy · InternalQ" %>
<% content_for :meta_description, "How InternalQ collects, uses, and protects your information. In plain English, then in detail." %>
<% content_for :canonical_url, "https://internalq.zezlab.com/privacy" %>

<%# ── Icon SVGs ── %>
<% shield_svg = '<svg width="18" height="18" viewBox="0 0 20 20" fill="none"><path d="M10 2.5 4 4.6V10c0 3.4 2.5 6 6 7.5 3.5-1.5 6-4.1 6-7.5V4.6L10 2.5Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/><path d="m7.5 10 1.8 1.8L13 8.2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>'.html_safe %>
<% lock_svg   = '<svg width="18" height="18" viewBox="0 0 20 20" fill="none"><rect x="4.5" y="9" width="11" height="8" rx="1.8" stroke="currentColor" stroke-width="1.5"/><path d="M7 9V6.8A3 3 0 0 1 10 4a3 3 0 0 1 3 2.8V9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>'.html_safe %>
<% cite_svg   = '<svg width="18" height="18" viewBox="0 0 20 20" fill="none"><path d="M5 5.5h10M5 9h10M5 12.5h6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><circle cx="14.5" cy="13.5" r="2" stroke="currentColor" stroke-width="1.5"/></svg>'.html_safe %>
<% mail_svg   = '<svg width="16" height="16" viewBox="0 0 20 20" fill="none"><rect x="3" y="5" width="14" height="10" rx="2" stroke="currentColor" stroke-width="1.5"/><path d="m3.5 6 6.5 5 6.5-5" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg>'.html_safe %>

<%= render layout: "pages/public_doc_shell", locals: { active: :privacy } do %>

<%# ── Page header ── %>
<section class="lp-page-header doc">
  <div class="lp-shell">
    <div class="lp-section-eyebrow">Legal · Privacy</div>
    <h1>Privacy policy.</h1>
    <p>How InternalQ collects, uses, and protects your information. In plain English, then in detail.</p>
    <div class="lp-updated">
      Last updated · May 13, 2026
      <span class="lp-dot"></span>
      Effective immediately
    </div>
  </div>
</section>

<%# ── Commitments strip ── %>
<section class="lp-commit-strip">
  <div class="lp-shell">
    <div class="lp-commit-grid">
      <div class="lp-commit">
        <span class="lp-glyph"><%= shield_svg %></span>
        <h3>Encrypted everywhere</h3>
        <p>Your documents are encrypted at rest and in transit. Workspace-scoped at the storage layer.</p>
      </div>
      <div class="lp-commit">
        <span class="lp-glyph"><%= lock_svg %></span>
        <h3>Not training data</h3>
        <p>Your content is never used to train AI models. We use enterprise endpoints with zero retention.</p>
      </div>
      <div class="lp-commit">
        <span class="lp-glyph"><%= cite_svg %></span>
        <h3>Minimum Slack scopes</h3>
        <p>The bot only sees messages where it's mentioned or DM'd. No arbitrary channel history.</p>
      </div>
    </div>
  </div>
</section>

<%# ── Doc article ── %>
<div class="lp-shell">
  <div class="lp-doc-wrap" data-controller="lp-doc-toc">
    <aside class="lp-doc-toc">
      <div class="lp-toc-label">On this page</div>
      <a href="#collect" data-lp-doc-toc-target="link">Information we collect</a>
      <a href="#use"     data-lp-doc-toc-target="link">How we use it</a>
      <a href="#storage" data-lp-doc-toc-target="link">Data storage and security</a>
      <a href="#slack"   data-lp-doc-toc-target="link">Slack integration</a>
      <a href="#contact" data-lp-doc-toc-target="link">Contact</a>
    </aside>

    <article class="lp-doc-body">

      <section id="collect">
        <h2><span class="lp-num">01</span>Information we collect</h2>
        <p>
          We collect information you provide when you sign up (e.g. email address),
          documents and content you upload to your organization's knowledge base,
          and usage data necessary to operate the service (including Slack workspace
          identifiers when you connect the Slack integration).
        </p>
      </section>

      <section id="use">
        <h2><span class="lp-num">02</span>How we use it</h2>
        <p>
          We use this information to provide and improve InternalQ: to index your
          documents for search, to answer questions (including via the Slack bot),
          to manage your account and organization, and to communicate with you
          about the service.
        </p>
      </section>

      <section id="storage">
        <h2><span class="lp-num">03</span>Data storage and security</h2>
        <p>
          Your data is stored in secure, access-controlled environments. We do
          not sell your personal information or document content to third parties.
        </p>
        <div class="lp-callout">
          <span class="lp-glyph"><%= lock_svg %></span>
          <div>
            <p><strong>We never sell your data.</strong> Not to advertisers, not to data brokers, not to AI training pipelines.</p>
          </div>
        </div>
      </section>

      <section id="slack">
        <h2><span class="lp-num">04</span>Slack integration</h2>
        <p>
          When you connect Slack, we receive and store tokens and workspace
          identifiers needed to deliver the bot (for example, responding to
          mentions or direct messages). The bot uses the minimum scopes
          required so it can see messages sent directly to it or where it is
          mentioned, and send replies:
        </p>
        <div class="lp-scope-list">
          <span class="lp-scope"><code>app_mentions:read</code><span class="lp-desc">— read @-mentions</span></span>
          <span class="lp-scope"><code>im:history</code><span class="lp-desc">— read DMs to the bot</span></span>
          <span class="lp-scope"><code>chat:write</code><span class="lp-desc">— send replies</span></span>
        </div>
        <p>
          We do not read or store arbitrary channel history, only the messages
          needed to answer specific questions in DMs or channel threads. You can
          disconnect the integration at any time from Integrations in the app,
          which revokes our access and stops the bot from responding.
        </p>
      </section>

      <section id="contact">
        <h2><span class="lp-num">05</span>Contact</h2>
        <p>
          For privacy-related questions, contact us at
          <a href="mailto:support@internalq.zezlab.com">support@internalq.zezlab.com</a>
          or via our <a href="<%= support_path %>">Support</a> page.
        </p>
      </section>

      <div class="lp-doc-cta">
        <div>
          <h3>Still have questions about how we handle data?</h3>
          <p>We're a small team. Email us — a real person will answer, usually same day.</p>
        </div>
        <div class="lp-actions">
          <a class="lp-btn lp-btn-outline" href="mailto:support@internalq.zezlab.com">
            <%= mail_svg %> Email support
          </a>
          <a class="lp-btn lp-btn-plan-primary" href="<%= root_path(anchor: "security") %>">
            Read about security
          </a>
        </div>
      </div>

    </article>
  </div>
</div>

<% end %>
