<% content_for :title, "Terms of Service · InternalQ" %>
<% content_for :meta_description, "Simple terms for using InternalQ and the Slack app." %>
<% content_for :canonical_url, "https://internalq.zezlab.com/terms" %>

<% mail_svg = '<svg width="16" height="16" viewBox="0 0 20 20" fill="none"><rect x="3" y="5" width="14" height="10" rx="2" stroke="currentColor" stroke-width="1.5"/><path d="m3.5 6 6.5 5 6.5-5" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg>'.html_safe %>

<%# ── Nav ── %>
<header class="lp-nav" data-controller="lp-nav">
  <div class="lp-shell lp-nav-inner">
    <a href="<%= root_path %>" class="lp-nav-brand">
      <%= image_tag "internalQ-icon.png", alt: "InternalQ", class: "lp-brand-logo" %>
      InternalQ
    </a>

    <nav class="lp-nav-links" aria-label="Site navigation">
      <%= link_to "How it works", root_path(anchor: "how") %>
      <%= link_to "Examples",     root_path(anchor: "demo") %>
      <%= link_to "Security",     root_path(anchor: "security") %>
      <%= link_to "FAQ",          root_path(anchor: "faq") %>
      <%= link_to "Pricing",      pricing_path %>
    </nav>

    <div class="lp-nav-cta">
      <%= button_to user_google_oauth2_omniauth_authorize_path,
                    method: :post,
                    class: "lp-btn lp-btn-brand lp-btn-brand-sm",
                    data: { no_loading: true },
                    form: { data: { turbo: false }, style: "margin:0" } do %>
        Get started free
      <% end %>
    </div>
  </div>
</header>

<%# ── Page header ── %>
<section class="lp-page-header doc">
  <div class="lp-shell">
    <div class="lp-section-eyebrow">Legal · Terms</div>
    <h1>Terms of service.</h1>
    <p>Simple terms for using InternalQ and the Slack app.</p>
    <div class="lp-updated">
      Last updated · May 13, 2026
      <span class="lp-dot"></span>
      Effective immediately
    </div>
  </div>
</section>

<%# ── Plain-English summary strip ── %>
<section class="lp-tldr-strip">
  <div class="lp-shell">
    <div class="lp-tldr-card">
      <div class="lp-tldr-label">Plain-English summary</div>
      <ul class="lp-tldr-list">
        <li><span class="lp-n">01</span><span><strong>Who we are.</strong> An internal AI search tool — web and Slack.</span></li>
        <li><span class="lp-n">02</span><span><strong>Your account and organization.</strong> First user is admin. Keep your login secure.</span></li>
        <li><span class="lp-n">03</span><span><strong>Your content.</strong> You own your docs. We only use them to answer.</span></li>
        <li><span class="lp-n">04</span><span><strong>Slack integration.</strong> Minimum scopes. Disconnect any time.</span></li>
        <li><span class="lp-n">05</span><span><strong>Acceptable use.</strong> Don't break the law or send spam.</span></li>
        <li><span class="lp-n">06</span><span><strong>No guarantees.</strong> AI can be wrong. Don't rely on it for regulated advice.</span></li>
        <li><span class="lp-n">07</span><span><strong>Changes.</strong> We'll tell you when these terms change.</span></li>
        <li><span class="lp-n">08</span><span><strong>Contact.</strong> Email us if you have questions.</span></li>
      </ul>
    </div>
  </div>
</section>

<%# ── Doc article ── %>
<div class="lp-shell">
  <div class="lp-doc-wrap" data-controller="lp-doc-toc">
    <aside class="lp-doc-toc">
      <div class="lp-toc-label">On this page</div>
      <a href="#who"        data-lp-doc-toc-target="link">Who we are</a>
      <a href="#account"    data-lp-doc-toc-target="link">Your account and organization</a>
      <a href="#content"    data-lp-doc-toc-target="link">Your content</a>
      <a href="#slack"      data-lp-doc-toc-target="link">Slack integration</a>
      <a href="#use"        data-lp-doc-toc-target="link">Acceptable use</a>
      <a href="#guarantees" data-lp-doc-toc-target="link">No guarantees</a>
      <a href="#changes"    data-lp-doc-toc-target="link">Changes</a>
      <a href="#contact"    data-lp-doc-toc-target="link">Contact</a>
    </aside>

    <article class="lp-doc-body">

      <section id="who">
        <h2><span class="lp-num">01</span>Who we are</h2>
        <p>InternalQ is an internal AI search tool that lets your team ask questions about your own documents, in the web app and in Slack.</p>
      </section>

      <section id="account">
        <h2><span class="lp-num">02</span>Your account and organization</h2>
        <p>The first person who signs up for InternalQ for a company becomes the admin for that organization. Admins can connect Slack, upload and delete documents, and manage other members. You are responsible for keeping your login details secure and for the activity that happens under your organization.</p>
      </section>

      <section id="content">
        <h2><span class="lp-num">03</span>Your content</h2>
        <p>You control the documents and content you upload to InternalQ. We only use your content to provide the service (for example, indexing documents so we can answer questions). You must have the rights to upload and use that content.</p>
        <p>Admins can delete documents and, if needed, request that we remove all organization data. See our <a href="<%= privacy_path %>">Privacy policy</a> for more details.</p>
      </section>

      <section id="slack">
        <h2><span class="lp-num">04</span>Slack integration</h2>
        <p>When you connect Slack, InternalQ receives a bot token and workspace identifiers so the bot can respond to mentions. The bot only reads messages where it is mentioned and uses the minimum Slack scopes required to work. You can disconnect Slack at any time from the Integrations page, which stops the bot from responding.</p>
      </section>

      <section id="use">
        <h2><span class="lp-num">05</span>Acceptable use</h2>
        <p>You agree not to use InternalQ to break the law, send spam, or share content that is illegal, abusive, or infringes on others' rights. We may suspend or terminate access if we detect abuse or security risks.</p>
      </section>

      <section id="guarantees">
        <h2><span class="lp-num">06</span>No guarantees</h2>
        <p>InternalQ is provided "as is" without warranties of any kind. Answers are generated by an AI model and may be inaccurate or incomplete. You should not rely on InternalQ for legal, medical, or other regulated advice.</p>
      </section>

      <section id="changes">
        <h2><span class="lp-num">07</span>Changes</h2>
        <p>We may update these terms from time to time. If changes are material, we will highlight them in the app or on this page. Your continued use of InternalQ after changes take effect means you accept the updated terms.</p>
      </section>

      <section id="contact">
        <h2><span class="lp-num">08</span>Contact</h2>
        <p>If you have questions about these terms, contact us at <a href="mailto:support@internalq.zezlab.com">support@internalq.zezlab.com</a> or via the <a href="<%= support_path %>">Support</a> page.</p>
      </section>

      <div class="lp-doc-cta">
        <div>
          <h3>Need clarification on something?</h3>
          <p>Plain-English questions get plain-English answers. We respond within a business day.</p>
        </div>
        <div class="lp-actions">
          <a class="lp-btn lp-btn-outline" href="mailto:support@internalq.zezlab.com">
            <%= mail_svg %> Email support
          </a>
          <a class="lp-btn lp-btn-plan-primary" href="<%= privacy_path %>">
            Read privacy policy
          </a>
        </div>
      </div>

    </article>
  </div>
</div>

<%# ── Footer ── %>
<footer class="lp-footer">
  <div class="lp-shell">
    <div class="lp-footer-grid">
      <div>
        <a href="<%= root_path %>" class="lp-nav-brand">
          <%= image_tag "internalQ-icon.png", alt: "InternalQ", class: "lp-brand-logo" %>
          InternalQ
        </a>
        <p class="lp-footer-tagline">An AI knowledge assistant for Slack teams. Cited answers from your own documents — never the open web.</p>
      </div>

      <div class="lp-footer-col">
        <h5>Product</h5>
        <ul>
          <li><%= link_to "How it works", root_path(anchor: "how") %></li>
          <li><%= link_to "Examples",     root_path(anchor: "demo") %></li>
          <li><%= link_to "Pricing",      pricing_path %></li>
        </ul>
      </div>

      <div class="lp-footer-col">
        <h5>Trust</h5>
        <ul>
          <li><%= link_to "Security",       root_path(anchor: "security") %></li>
          <li><%= link_to "Privacy policy", privacy_path %></li>
          <li><span style="color:#0b0f0e;font-weight:500">Terms of service</span></li>
        </ul>
      </div>

      <div class="lp-footer-col">
        <h5>Company</h5>
        <ul>
          <li><%= link_to "Support",  support_path %></li>
          <li><a href="mailto:support@internalq.zezlab.com">Email us</a></li>
        </ul>
      </div>
    </div>

    <div class="lp-footer-bottom">
      <span>&copy; 2026 InternalQ</span>
      <span class="lp-footer-status">
        <span class="lp-status-dot"></span>
        All systems operational
      </span>
    </div>
  </div>
</footer>
