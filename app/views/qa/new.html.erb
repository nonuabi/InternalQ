<div class="kv-page">
  <div class="kv-page-header">
    <div class="kv-heading-group">
      <h1>Q&A</h1>
      <p class="kv-page-subtitle">Ask your company anything. Answers are generated from your documents and cite sources.</p>
    </div>
    <div class="kv-badge-row">
      <div class="kv-pill">
        <span class="kv-pill-dot"></span>
        Private to your org
      </div>
      <%= link_to "Documents", documents_path, class: "kv-ghost-button" %>
    </div>
  </div>

  <% has_docs = current_user.organization.present? && current_user.organization.documents.count > 0 %>

  <% unless has_docs %>
    <div class="kv-empty-state" style="margin-top: 1.1rem;">
      <div class="kv-empty-main">
        <div class="kv-empty-title">Upload a document to get started</div>
        <div class="kv-empty-subtitle">
          Add a handbook, policy, or SOP. Then come back here to ask questions.
        </div>
      </div>
      <div style="margin-top: 0.9rem;">
        <%= link_to "Upload your first document", new_document_path(onboarding: "1"), class: "kv-primary-button" %>
      </div>
    </div>
  <% end %>

  <% if has_docs %>
  <%= form_with url: ask_path(onboarding: params[:onboarding]), method: :post, data: { turbo: false }, html: { class: "kv-form-grid", id: "kv-qa-form" } do %>
    <div>
      <div class="kv-field-label">Ask a question</div>
      <%= text_area_tag :question,
                        @question,
                        rows: 4,
                        class: "kv-textarea",
                        placeholder: "e.g. What is our parental leave policy? Or: Summarize the onboarding process." %>
      <div class="kv-field-hint">
        Ask about policies, benefits, procedures, or anything in your uploaded docs.
      </div>
    </div>

    <div class="kv-form-footer">
      <%= submit_tag "Ask", class: "kv-primary-button" %>
      <span class="kv-meta-text kv-meta-muted">
        Answers are AI-generated and cite source documents.
      </span>
    </div>
  <% end %>

  <div id="kv-answer-container">
  <% if @answer.present? %>
    <div class="kv-answer-block">
      <div class="kv-answer-header">
        <div>
          <div class="kv-answer-title">Answer</div>
          <div class="kv-meta-text kv-meta-muted">
            Generated from your internal documents.
          </div>
        </div>
        <div class="kv-chip">
          <span class="kv-chip-dot"></span>
          AI generated
        </div>
      </div>

      <div class="kv-answer-body">
        <%= @answer %>
      </div>
    </div>

    <% if defined?(@show_slack_prompt) && @show_slack_prompt && current_user.admin? %>
      <div class="kv-empty-state" style="margin-top: 1.1rem;">
        <div class="kv-empty-main">
          <div class="kv-empty-title">Bring Q&A into Slack</div>
          <div class="kv-empty-subtitle">
            Let your team ask questions right from Slack. 2-minute setup, admin only.
          </div>
        </div>
        <div style="margin-top: 0.9rem;">
          <%= link_to "Connect Slack", slack_connect_path, class: "kv-primary-button" %>
        </div>
      </div>
    <% end %>
  <% end %>
  </div>
  <% end %>

  <script>
    document.addEventListener("DOMContentLoaded", function() {
      var form = document.getElementById("kv-qa-form");
      var container = document.getElementById("kv-answer-container");
      if (form && container) {
        form.addEventListener("submit", function() {
          container.style.display = "none";
        });
      }
    });
  </script>
</div>